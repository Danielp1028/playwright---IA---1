{
  "name": "automation-of-playwrighy-with-ia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "pretest:cucumber": "npx playwright install",
    "build": "tsc --noEmit",
    "check": "tsc --noEmit",
    "test:cucumber": "cucumber-js --require-module ts-node/register --require 'src/Steps/**/*.ts' 'src/feature/**/*.feature'",
    "test:cucumber:login1": "cucumber-js --require-module ts-node/register --require 'src/Steps/**/*.ts' --tags '@Login_1' 'src/feature/**/*.feature'",
    "test:cucumber:login2": "cucumber-js --require-module ts-node/register --require 'src/Steps/**/*.ts' --tags '@login_2' 'src/feature/**/*.feature'",
    "test:cucumber:login3": "cucumber-js --require-module ts-node/register --require 'src/Steps/**/*.ts' --tags '@login_3' 'src/feature/**/*.feature'",
    "test:cucumber:tag": "cucumber-js --require-module ts-node/register --require 'src/Steps/**/*.ts' --tags",
    "test:cucumber:runtag": "sh -c 'tag=\"$1\"; shift; headless=0; workers=1; slowmo=50; while [ \"$#\" -gt 0 ]; do case \"$1\" in --headed) headless=0; shift;; --headless) headless=1; shift;; --workers) workers=\"$2\"; shift 2;; --slowmo) slowmo=\"$2\"; shift 2;; *) shift;; esac; done; HEADLESS=\"$headless\" WORKERS=\"$workers\" SLOWMO=\"$slowmo\" cucumber-js --require-module ts-node/register --require \"src/Steps/**/*.ts\" --tags \"$tag\" \"src/feature/**/*.feature\"' --"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.1",
    "dayjs": "^1.11.19",
    "docx": "^9.5.1",
    "fs-extra": "^11.3.2",
    "playwright": "^1.56.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
